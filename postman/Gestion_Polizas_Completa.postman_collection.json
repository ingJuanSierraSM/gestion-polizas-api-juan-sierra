              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "core-mock",
                "evento"
              ]
            },
            "description": "Prueba directamente el endpoint que simula el CORE.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operacion\": \"RENOVAR_POLIZA\",\n  \"polizaId\": 1,\n  \"riesgoId\": null\n}",
              "options": {
